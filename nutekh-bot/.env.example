# ---------------------------------------------------------------------------
# Nutekh WhatsApp Assistant — configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM (required) --------------------------------------------------------
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini

# Optional fallbacks (comma-separated model names on the same endpoint)
# LLM_FALLBACK_MODELS=
# LLM_CONCURRENCY=4

# --- WhatsApp --------------------------------------------------------------
# Dedicated assistant number, international format, digits only.
# Used to recognise the bot's own mentions and for pairing on first run.
PHONE=2507XXXXXXXX

# Who gets lead alerts, and whose DMs can run owner commands.
# Comma-separated phone numbers or full JIDs. Example: 250788000000,250787000000
OWNER_JIDS=

# Groups where the bot may reply when directly addressed (JIDs ending @g.us).
# Leave empty to allow any group the number is in (still requires being addressed).
ANSWER_GROUPS=

# Groups whose messages are ingested into the knowledge base.
ALLOWED_GROUPS=

# Master switch for group replies. Keep 0 until you have tested in a group.
GROUP_ANSWER=0

# Ingest group messages into local knowledge (0 = off).
GROUP_INGEST=0

# --- Direct messages -------------------------------------------------------
# 1 = answer any DM. If 0, only OWNER_JIDS can talk to it.
DM_ALWAYS_OPEN=1
# Optional per-customer message cap; 0 = unlimited.
DM_MAX=0

# Natural typing pause before replying (milliseconds).
ANSWER_DELAY_MIN=700
ANSWER_DELAY_MAX=1800

# --- Storage ---------------------------------------------------------------
# Defaults are inside this folder; override for backups or a mounted disk.
# DATA_DIR=./data
# DOC_DIR=./documents
# MEDIA_DIR=./media
# LOG_FILE=./logs/messages.jsonl

# --- Embeddings (optional but recommended) --------------------------------
# The bundled embed-service.py listens here (fastembed, multilingual).
EMBED_URL=http://127.0.0.1:7867

# --- OCR (optional) --------------------------------------------------------
# An OCR HTTP service that accepts multipart "file" + "lang" and returns
# {"text": "..."}. Leave empty to disable document/image text extraction.
OCR_URL=

# --- Email alerts (optional) ----------------------------------------------
# Resend is used only for lead/support notifications.
RESEND_API_KEY=
RESEND_FROM=Nutekh Assistant <info@nutekh.com>
RESEND_TO=hello@nutekh.com

# --- Lead capture ----------------------------------------------------------
# A second extraction pass runs when the model answers a substantial enquiry
# without emitting a lead marker. Minimum message length to trigger it.
# LEAD_EXTRACT_MIN_CHARS=50
# The same contact asking the same thing again within this window is treated as
# one lead (no duplicate record, no second owner alert).
# LEAD_DEDUPE_HOURS=6

# --- Group prospecting -----------------------------------------------------
# Master switch. Keep 0 until you have tested in a group; set to 1 once, then
# adding the bot to a group is the only action needed.
PROSPECT_ENABLED=0
# Optional override: empty = prospect every group the bot is in; non-empty =
# only these group ids (comma-separated, ending @g.us).
PROSPECT_GROUPS=
# How often the scan timer runs, in minutes.
SCAN_INTERVAL_MIN=10
# Pre-filter: a message needs at least this many letters to be classified.
SIGNAL_MIN_CHARS=40
# On first connect, only group messages this many hours old are captured.
BACKFILL_HOURS=72
# Max approved outreach sends per day.
OUTREACH_DAILY_CAP=5
# Per-member re-contact cooldown, in days.
OUTREACH_COOLDOWN_DAYS=30
# Minimum classifier confidence for a message to become a signal.
OUTREACH_MIN_CONFIDENCE=0.6
