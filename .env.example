# Optional — enables GA4 on every built HTML page via `.eleventy.js` transform.
# Loaded automatically by `dotenv` when you run `npm run build` or `npm run dev` (copy this file to `.env`).
# Create a GA4 property: Google Analytics → Admin → Data streams → Web → Measurement ID (format G-XXXXXXXXXX).
# Vercel: Project Settings → Environment Variables → GA_MEASUREMENT_ID (Production + Preview as needed).
GA_MEASUREMENT_ID=

# Resend (`/api/contact` on Vercel). Never commit the real key — add in Vercel → Environment Variables.
# Domain nutekh.com must be verified in Resend before using info@nutekh.com as `from`.
RESEND_API_KEY=
# Optional overrides (defaults: Nutekh <info@nutekh.com> → info@nutekh.com)
# RESEND_FROM=Nutekh <info@nutekh.com>
# RESEND_TO=info@nutekh.com
